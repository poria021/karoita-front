{
  "_note": "مسیرهای Advertisements تا وقتی در openapi.snapshot.json نیایند اینجا می‌مانند. بعد از `pnpm fake-api:sync` اگر در snapshot بودند از این فایل حذفشان کنید.",
  "paths": {
    "/api/v1/advertisements": {
      "get": {
        "summary": "[proposed-until-sync] List ads or infos visible to the current user",
        "parameters": [
          {
            "name": "type",
            "required": true,
            "in": "query",
            "schema": { "type": "string", "enum": ["ads", "info"] }
          },
          {
            "name": "placement",
            "required": true,
            "in": "query",
            "schema": { "type": "string", "enum": ["hero", "sidebar"] }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/PublicAdvertisementDto" }
                }
              }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["Advertisements"]
      }
    },
    "/api/v1/advertisements/{id}/clicks": {
      "post": {
        "summary": "[proposed-until-sync] Record a click on an advertisement",
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "success": { "type": "boolean" } },
                  "required": ["success"]
                }
              }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["Advertisements"]
      }
    },
    "/api/admin/advertisements": {
      "post": {
        "summary": "[proposed-until-sync] Create ads or info",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAdvertisementDto" }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Advertisement" }
              }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["Admin advertisements"]
      },
      "get": {
        "summary": "[proposed-until-sync] List advertisements for the admin table",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InfinityPaginationAdvertisementResponseDto" }
              }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["Admin advertisements"]
      }
    },
    "/api/admin/advertisements/{id}": {
      "get": {
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Advertisement" }
              }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["Admin advertisements"]
      },
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateAdvertisementDto" }
            }
          }
        },
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Advertisement" }
              }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["Admin advertisements"]
      },
      "delete": {
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "" } },
        "security": [{ "bearer": [] }],
        "tags": ["Admin advertisements"]
      }
    },
    "/api/admin/advertisements/{id}/activation": {
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ToggleAdvertisementDto" }
            }
          }
        },
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Advertisement" }
              }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["Admin advertisements"]
      }
    }
  },
  "schemas": {
    "FileType": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "originalName": { "type": "string" },
        "mimeType": { "type": "string" },
        "size": { "type": "number" },
        "uploadedById": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed"] },
        "confirmedAt": { "type": "string", "nullable": true }
      },
      "required": ["id", "path", "originalName", "mimeType", "size", "uploadedById", "status"]
    },
    "FileDto": {
      "type": "object",
      "properties": { "id": { "type": "string" } },
      "required": ["id"]
    },
    "PublicAdvertisementDto": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["ads", "info"] },
        "format": { "type": "string", "enum": ["text", "image"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "link": { "type": "string", "nullable": true },
        "placement": { "type": "string", "enum": ["hero", "sidebar"] },
        "image": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/FileType" }] },
        "createdByRole": { "type": "string", "nullable": true }
      },
      "required": ["id", "type", "format", "title", "body", "placement"]
    },
    "CreateAdvertisementDto": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "enum": ["ads", "info"] },
        "format": { "type": "string", "enum": ["text", "image"] },
        "body": { "type": "string", "maxLength": 250 },
        "link": { "type": "string", "nullable": true },
        "placement": { "type": "string", "enum": ["hero", "sidebar"] },
        "image": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/FileDto" }] },
        "targetRoles": { "type": "array", "items": { "type": "string" } },
        "targetProvinceIds": { "type": "array", "items": { "type": "string" } },
        "targetUniversityIds": { "type": "array", "items": { "type": "string" } },
        "targetUserIds": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" }
      },
      "required": ["title", "type", "format", "body", "placement"]
    },
    "UpdateAdvertisementDto": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 50 },
        "body": { "type": "string", "maxLength": 250 },
        "link": { "type": "string", "nullable": true },
        "placement": { "type": "string", "enum": ["hero", "sidebar"] },
        "image": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/FileDto" }] },
        "targetRoles": { "type": "array", "items": { "type": "string" } },
        "targetProvinceIds": { "type": "array", "items": { "type": "string" } },
        "targetUniversityIds": { "type": "array", "items": { "type": "string" } },
        "targetUserIds": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" }
      }
    },
    "ToggleAdvertisementDto": {
      "type": "object",
      "properties": { "isActive": { "type": "boolean" } },
      "required": ["isActive"]
    },
    "Advertisement": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["ads", "info"] },
        "format": { "type": "string", "enum": ["text", "image"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "link": { "type": "string", "nullable": true },
        "placement": { "type": "string", "enum": ["hero", "sidebar"] },
        "image": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/FileType" }] },
        "targetRoles": { "type": "array", "items": { "type": "string" } },
        "targetProvinceIds": { "type": "array", "items": { "type": "string" } },
        "targetUniversityIds": { "type": "array", "items": { "type": "string" } },
        "targetUserIds": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "inactive", "expired"] },
        "clickCount": { "type": "number" },
        "impressionCount": { "type": "number" },
        "startsAt": { "type": "string" },
        "endsAt": { "type": "string", "nullable": true },
        "createdByRole": { "type": "string", "nullable": true },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "type",
        "format",
        "title",
        "body",
        "placement",
        "targetRoles",
        "targetProvinceIds",
        "targetUniversityIds",
        "targetUserIds",
        "isActive",
        "clickCount",
        "impressionCount",
        "startsAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "InfinityPaginationAdvertisementResponseDto": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/Advertisement" }
        },
        "hasNextPage": { "type": "boolean" }
      },
      "required": ["data", "hasNextPage"]
    }
  }
}

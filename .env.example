# ─── API mode (critical for production) ─────────────────────────────────────
# mock  → localStorage / in-browser fakes (development only)
# real  → NestJS / Better-Auth over NEXT_PUBLIC_API_URL
#
# Rules (see src/lib/api-mode.ts):
# - Development: unset defaults to mock
# - Production: unset defaults to real; explicit mock throws at runtime
# Never ship production with NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_MODE=mock

# Base URL for Nest (no trailing slash). Required when API_MODE=real.
# Example: https://api.example.com  or  http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional: override the session cookie name used by Edge proxy (default Better-Auth).
# NEXT_PUBLIC_AUTH_COOKIE_NAME=better-auth.session_token

# ─── Better-Auth (local / bridge) ───────────────────────────────────────────
# حداقل ۳۲ کاراکتر با آنتروپی بالا — تولید:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace_me_with_openssl_or_node_crypto_randomBytes_32
BETTER_AUTH_URL=http://localhost:3000

# ─── Public site URL (SEO / Open Graph absolute links) ───────────────────────
# Production example: https://karvita.ir
# Unset → VERCEL_URL, then http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://karvita.ir

# ─── API mode (critical for production) ─────────────────────────────────────
# mock  → localStorage / in-browser simulator (development only)
# real  → NestJS over NEXT_PUBLIC_API_URL
#
# Rules (see src/lib/api-mode.ts):
# - Development: unset defaults to mock
# - Production: unset defaults to real; explicit mock throws at runtime
# Never ship production with NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_MODE=mock

# Base URL for Nest (no trailing slash). Required when API_MODE=real.
# Example: https://api.example.com  or  http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional: Nest httpOnly session cookie name for Edge proxy (default karvita_session).
# NEXT_PUBLIC_AUTH_COOKIE_NAME=karvita_session

# ─── App surface (future user vs admin hostname) ─────────────────────────────
# user  (default) → public login at /auth/login; /auth/admin-gate still works
# admin → deploy on admin subdomain; /auth/login redirects to /auth/admin-gate
# Nest still enforces role — this only chooses entry chrome (see ADR-004).
# NEXT_PUBLIC_APP_SURFACE=user

# ─── Observability (optional; no vendor loaded unless set) ───────────────────
# Public Sentry DSN — browser + server store API (no @sentry/nextjs required).
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Generic JSON webhook for crashes (self-hosted collector).
# NEXT_PUBLIC_ERROR_WEBHOOK_URL=https://example.com/errors
# First-party analytics beacon (page_view). Leave unset to send nothing.
# NEXT_PUBLIC_ANALYTICS_BEACON_URL=https://example.com/collect

# PWA service worker is generated on `next build` (production) and registered
# after first paint. Disabled in `next dev`. Do not cache Nest/API in the SW.

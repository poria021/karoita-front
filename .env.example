# لوکال: cp .env.example .env.local  (commit نشود)
# NEXT_PUBLIC_* موقع pnpm build داخل باندل می‌رود.

NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IS_DEV=true

# کار بدون بک‌اند با سرور جعلی Nest (`pnpm fake-api`، ببین docs/data-flow.md):
# NEXT_PUBLIC_API_MODE=real
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
# BACKEND_INTERNAL_URL=http://localhost:4000/api

# اتصال به Nest واقعی روی لوکال (به‌جای mock):
# NEXT_PUBLIC_API_MODE=real
# NEXT_PUBLIC_API_URL=https://your-nest-host/api
# BACKEND_INTERNAL_URL=https://your-nest-host/api
# NEXT_PUBLIC_S3_URL=https://your-bucket.hs3.ir

# روی بک‌اند واقعی، فقط مسیرهای پیشنهادی (اطلاعیه/تبلیغ) را به سرور جعلی بفرست (فقط dev؛ production نادیده گرفته می‌شود):
# FAKE_PROPOSED_API_URL=http://localhost:4000/api

# تنظیم نحوه اتصال به بک‌اِند (mock: استفاده از localStorage فعلی | real: اتصال به NestJS)
NEXT_PUBLIC_API_MODE=mock

# آدرس پایه API (زمانی که در حالت real قرار گرفتید)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# پیکربندی Better-Auth
# حداقل ۳۲ کاراکتر با آنتروپی بالا — تولید: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace_me_with_openssl_or_node_crypto_randomBytes_32
BETTER_AUTH_URL=http://localhost:3000
# ─── محلی (cp .env.example .env.local) ───────────────────────────────────────
# Development: اگر NEXT_PUBLIC_API_MODE خالی باشد پیش‌فرض mock است.
# Production: پیش‌فرض real است؛ مقدار mock صریح کرش می‌کند.
#
# روی سرور این فایل را کپی نکنید. از `.env.production.example` استفاده کنید.
# NEXT_PUBLIC_* موقع `pnpm build` داخل باندل می‌رود، نه موقع `pnpm start`.

NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# فقط لوکال / برنچ dev. روی سرور نگذارید (حتی false لازم نیست).
NEXT_PUBLIC_IS_DEV=true

# ─── پروداکشن (روی سرور الزامی) ──────────────────────────────────────────────
# NEXT_PUBLIC_API_MODE=real
# NEXT_PUBLIC_API_URL=https://api.example.com/api
# NEXT_PUBLIC_SITE_URL=https://karvita.ir
# NEXT_PUBLIC_S3_URL=https://your-bucket.s3.region.amazonaws.com

# Public site URL (SEO / Open Graph). Unset → VERCEL_URL، بعد localhost.
# NEXT_PUBLIC_SITE_URL=https://karvita.ir

# مبدأ عمومی باکت S3/MinIO برای پیش‌نمایش مدرک هویت (معمولاً فقط object key).
# NEXT_PUBLIC_S3_URL=https://your-bucket.s3.ir-thr-at1.arvanstorage.ir

# اختیاری: نام کوکی نشست Edge (پیش‌فرض karvita_session).
# NEXT_PUBLIC_AUTH_COOKIE_NAME=karvita_session

# اختیاری: آدرس داخلی Nest برای Route Handler رفرش (بدون CORS).
# اگر خالی باشد همان NEXT_PUBLIC_API_URL استفاده می‌شود.
# BACKEND_INTERNAL_URL=http://127.0.0.1:4000/api

# ─── سطح ورود (آینده: ساب‌دامین ادمین) ──────────────────────────────────────
# user  (پیش‌فرض) → لاگین عمومی /auth/login؛ /auth/admin-gate همچنان کار می‌کند
# admin → روی ساب‌دامین ادمین؛ /auth/login به /auth/admin-gate می‌رود
# قفل نقش همچنان با Nest است.
# NEXT_PUBLIC_APP_SURFACE=user

# ─── مشاهده‌پذیری (اختیاری؛ تا ست نشود هیچ vendor لود نمی‌شود) ──────────────
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_ERROR_WEBHOOK_URL=https://example.com/errors
# NEXT_PUBLIC_ANALYTICS_BEACON_URL=https://example.com/collect

# PWA service worker روی `next build` ساخته می‌شود و در `next dev` خاموش است.
# Nest/API را در SW کش نکنید.

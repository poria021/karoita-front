/**
 * Shared marker for the DEV-ONLY admin-gate login bypass
 * (`src/services/auth/dev-admin-gate-bypass.ts`).
 *
 * Kept in its own dependency-free file (no browser/store imports) so both
 * sides can safely import it:
 * - `dev-admin-gate-bypass.ts` (browser) uses it to *tag* the fabricated
 *   refresh-token string it never actually persists anymore.
 * - `src/app/api/auth/refresh/route.ts` (Node/server) uses it to *reject*
 *   any such value it finds on the `karvita_rt` cookie — belt-and-suspenders
 *   against a value written before this guard existed, or written by any
 *   future bug. A bypass token is never valid input for the real Nest
 *   refresh endpoint; forwarding it there is what caused Nest to 500.
 */
export const DEV_BYPASS_REFRESH_TOKEN_PREFIX = 'dev-bypass-refresh.';

export function isDevBypassRefreshToken(value: string | undefined | null): boolean {
  return typeof value === 'string' && value.startsWith(DEV_BYPASS_REFRESH_TOKEN_PREFIX);
}

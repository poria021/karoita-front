# ایمیج نمایشی «ماکت» برای تیم (بدون Nest، داده و OTP ساختگی).
# فقط برای محیط جدا از production واقعی؛ ایمیج اصلی `Dockerfile` همچنان
# mock را در production مسدود می‌کند.
#
# نمونه:
#   docker build -f Dockerfile.mock -t karvita-frontend-mock \
#     --build-arg NEXT_PUBLIC_SITE_URL=https://mock.example.com .
#   docker run --rm -p 3000:3000 karvita-frontend-mock

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@11 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_S3_URL
ARG NEXT_PUBLIC_AUTH_COOKIE_NAME
ARG NEXT_PUBLIC_APP_SURFACE

# هر دو پرچم موقع بیلد داخل باندل (و Edge) اینلاین می‌شوند.
ENV NEXT_PUBLIC_API_MODE=mock
ENV NEXT_PUBLIC_ALLOW_MOCK_IN_PROD=true
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_S3_URL=$NEXT_PUBLIC_S3_URL
ENV NEXT_PUBLIC_AUTH_COOKIE_NAME=$NEXT_PUBLIC_AUTH_COOKIE_NAME
ENV NEXT_PUBLIC_APP_SURFACE=$NEXT_PUBLIC_APP_SURFACE
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NEXT_CPU_COUNT=1
ENV NODE_OPTIONS=--max-old-space-size=3072

RUN pnpm build

FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]

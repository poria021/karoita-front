# قالب پروداکشن — سکرت/آدرس واقعی را commit نکنید.
# بیلد داکر این فایل را نمی‌خواند. NEXT_PUBLIC_* اگر موقع build ست شود داخل باندل می‌رود.
# روی Darkube همین NEXT_PUBLIC_API_URL را روی پاد بگذارید (runtime).
# ایمیج داکر اگر BACKEND_INTERNAL_URL خالی باشد همان را کپی می‌کند.
# NEXT_PUBLIC_IS_DEV نگذارید.

NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_SITE_URL=https://karvita.ir
NEXT_PUBLIC_S3_URL=https://your-bucket.hs3.ir

# الزامی روی PaaS اگر NEXT_PUBLIC_API_URL موقع docker build خالی بوده:
BACKEND_INTERNAL_URL=https://api.example.com/api
# NEXT_PUBLIC_AUTH_COOKIE_NAME=karvita_session
# NEXT_PUBLIC_APP_SURFACE=user

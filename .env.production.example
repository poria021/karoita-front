# کپی روی سرور به `.env.production` یا env پروسس‌منیجر.
# این فایل را با مقدار واقعی commit نکنید.
#
# NEXT_PUBLIC_* در زمان `pnpm build` داخل باندل می‌رود.
# بعد از بیلد عوض کردن env کافی نیست — دوباره بیلد بگیرید.
#
# اجرا: pnpm build && pnpm start
# `pnpm dev` برای سرور نیست.

NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_SITE_URL=https://karvita.ir

# مبدأ عمومی باکت برای پیش‌نمایش مدرک هویت
# NEXT_PUBLIC_S3_URL=https://your-bucket.s3.region.amazonaws.com

# آدرس داخلی Nest برای POST /api/auth/refresh (اختیاری)
# BACKEND_INTERNAL_URL=http://127.0.0.1:4000/api

# NEXT_PUBLIC_AUTH_COOKIE_NAME=karvita_session
